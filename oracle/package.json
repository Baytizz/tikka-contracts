{
  "name": "oracle-service",
  "version": "1.0.0",
  "description": "Off-chain oracle service for Tikka Contracts",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/index.js",
    "test": "jest --passWithNoTests",
    "format": "prettier --write \"src/**/*.{ts,md}\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,md}\" \"*.md\""
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.6.1",
    "dotenv": "^16.4.5",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  }
}
