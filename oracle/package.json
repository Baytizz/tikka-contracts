{
  "name": "oracle-service",
  "version": "1.0.0",
  "description": "Off-chain oracle service for Tikka Contracts",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --runInBand"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/*.test.ts"],
    "transform": {
      "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
    }
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.1.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.12",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.4.5"
  }
}
